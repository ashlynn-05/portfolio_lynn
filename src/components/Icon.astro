---
// Phosphor icons, inlined at build time from @phosphor-icons/core. Never redrawn by hand.
import fs from 'node:fs';
import path from 'node:path';

interface Props { name: string; weight?: 'regular' | 'bold'; class?: string; label?: string }
const { name, weight = 'regular', class: cls = 'i', label } = Astro.props;

const file = path.join(
  process.cwd(), 'node_modules', '@phosphor-icons', 'core', 'assets', weight,
  weight === 'regular' ? `${name}.svg` : `${name}-${weight}.svg`,
);
const raw = fs.readFileSync(file, 'utf8');
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg class={cls} viewBox="0 0 256 256" fill="currentColor" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} set:html={inner} />
